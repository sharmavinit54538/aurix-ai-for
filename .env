# Backend API base URL (no trailing slash)
VITE_API_URL=https://api.ofc360.com

# VITE_API_URL= http://127.0.0.1:8000/

# Public frontend app URL (no trailing slash).
# Used for generating Job Application links, Career Site URLs, QR codes, etc.
# In development, leave unset — the app uses window.location.origin automatically.
# In production, set to your deployed frontend domain.
VITE_PUBLIC_APP_URL=https://app.ofc360.com